
generator client {
  provider      = "prisma-client-js"
  // Vercel serverless deployment support
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  name                  String
  email                 String   @unique
  password              String
  role                  String   @default("fresher")
  isPro                 Boolean  @default(false)
  isSuspended           Boolean  @default(false)
  aiCredits             Int      @default(1)

  // Credits granted by the current Pro billing cycle
  subscriptionCredits   Int?     @default(0)
  razorpaySubscriptionId String?

  // Referral system
  referralCode          String?  @unique
  referredById          String?  @db.ObjectId

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  resumes Resume[]

  @@map("users")
}

model Resume {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String   @db.ObjectId
  fileUrl          String
  fileName         String
  atsScore         Int?
  // Raw resume text retained after successful analysis
  storedResumeText String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis Analysis?

  @@map("resumes")
}

model Analysis {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  resumeId        String   @unique @db.ObjectId
  skillsScore     Int      @default(0)
  experienceScore Int      @default(0)
  educationScore  Int      @default(0)
  projectsScore   Int      @default(0)
  jobMatchScore   Int      @default(0)
  suggestions     String[]
  keywords        String[]
  missingKeywords String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("analyses")
}

model Feedback {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  rating      Int
  comment     String   @default("")
  adminStatus String?  @default("new")
  createdAt   DateTime @default(now())

  @@map("feedbacks")
}

model Payment {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  paymentId        String   @unique
  userId           String   @db.ObjectId
  planId           String
  amount           Int
  credits          Int
  refundedAmount   Int?     @default(0)
  refundId         String?
  refundStatus     String?
  refundReason     String?
  lastRefundAmount Int?
  lastRefundAt     DateTime?
  createdAt        DateTime @default(now())

  @@map("payments")
}

model AdminAuditLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  adminUserId String   @db.ObjectId
  adminEmail  String
  action      String
  targetType  String
  targetId    String?
  reason      String
  beforeValue String?
  afterValue  String?
  createdAt   DateTime @default(now())

  @@map("admin_audit_logs")
}

// Records each delivered gamification credit grant exactly once
model CreditGrant {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  eventKey   String   @unique
  userId     String   @db.ObjectId
  credits    Int
  sourceType String
  sourceId   String
  createdAt  DateTime @default(now())

  @@map("credit_grants")
}
