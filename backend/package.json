{
  "name": "careerlens-backend",
  "version": "1.0.0",
  "description": "CareerLens - AI Resume Analysis and Job Matching Backend API",
  "main": "src/server.js",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "node --watch src/server.js",
    "build": "prisma generate && node scripts/check-js.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma db push",
    "prisma:studio": "prisma studio",
    "prisma:seed": "node prisma/seed.js",
    "vercel-build": "prisma generate && node scripts/check-js.js"
  },
  "keywords": [
    "resume",
    "ai",
    "ats",
    "job-matcher"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "20.x"
  },
  "overrides": {
