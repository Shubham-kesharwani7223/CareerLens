    "uuid": "9.0.1"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "natural": "^8.1.1",
    "nodemailer": "^6.10.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.23.1",
    "razorpay": "^2.9.6",
    "stopword": "^3.1.5",
